# Database
DATABASE_URL="postgresql://username:password@localhost:5432/finbase"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OpenRouter (required for valuation and agentic analysis mode)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key"

# Optional: override the free OpenRouter models used for forecasts
# (comma-separated, tried in order until one succeeds)
# VALUATION_MODELS="nvidia/nemotron-3-ultra:free,deepseek/deepseek-chat-v3-0324:free"

# Optional: Arize AX tracing for the valuation LLM calls.
# Tracing turns on only when BOTH the space ID and API key are set.
# Both values come from your space settings in Arize AX (https://app.arize.com)
# ARIZE_SPACE_ID="your-arize-space-id"
# ARIZE_API_KEY="your-arize-api-key"
# ARIZE_PROJECT_NAME="fincast"
# Only for non-default regions (e.g. EU): full OTLP/HTTP traces URL
# ARIZE_OTLP_ENDPOINT="https://otlp.arize.com/v1/traces"

# Optional but recommended: free Finnhub key for reliable share prices from
# serverless environments. Get one at https://finnhub.io (60 requests/min free)
# FINNHUB_API_KEY="your-finnhub-api-key"
